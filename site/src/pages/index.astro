---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import { links, JOIN_URL } from '../data/links.ts';

import { reading } from '../data/reading.ts';

// Papers we recommend, not papers we wrote — the pinned ones lead.
const pickedReading = [...reading].filter((r) => r.pinned).slice(0, 3);

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPosts = allPosts.slice(0, 4);
// Every number says what it counts and comes from a collection — never hand-written.
// No "papers we published" figure: we curate and we write, we do not publish papers.
const aboutStats = [
  [String(reading.length), 'Papers on the reading list'],
  [String(allPosts.length), 'Articles written'],
  ['Free', 'To read and to join'],
];

const monthYear = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const title = 'QuantHQ | Read, discuss, and share quant research';
const description =
  'Read a curated quant finance reading list, discuss methods in our LinkedIn group, and share your own research notes.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://quanthq.in/#organization',
  name: 'QuantHQ',
  url: 'https://quanthq.in/',
  logo: 'https://quanthq.in/logo.jpeg',
  description,
  sameAs: [links.linkedinGroup, links.github],
};

// What a visitor actually gets. Three, each with a destination that exists.
const value = [
  {
    n: '01',
    title: 'A reading list, not a link dump',
    body: `${reading.length} papers that are actually worth the evening — from the equilibrium arguments the field rests on to what deep learning has really established about price formation. Each one says why it made the list.`,
    href: '/research/',
    cta: 'Open the reading list',
  },
  {
    n: '02',
    title: 'People reading the same things',
    body: 'The LinkedIn group is the place to share a paper, ask about its method, and discuss it with other readers.',
    href: JOIN_URL,
    cta: 'Join the group',
    external: true,
  },
  {
    n: '03',
    title: 'Somewhere to put your work',
    body: 'Written a replication, a negative result, or a useful method note? Email a short summary and a link. We can discuss whether it fits the site.',
    href: '/contact/',
    cta: 'Get in touch',
  },
];
---

<Base title={title} description={description}>
  <JsonLd slot="head" data={organizationSchema} />

  <!-- OPENING CURTAIN — first visit of the session only, and never without JS or
       under reduced motion. Purely CSS-timed: nothing removes it, so it must end
       transparent and non-interactive on its own. -->
  <script is:inline>
    if (sessionStorage.qhqIntro) document.documentElement.classList.add('intro-done');
    else { document.documentElement.classList.add('intro-play'); sessionStorage.qhqIntro = '1'; }
  </script>
  <div class="intro" aria-hidden="true">
    <div class="intro-inner">
      <span class="intro-mark">QuantHQ</span>
      <span class="intro-rule"></span>
      <span class="intro-sub">Open research community</span>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="shell hero-copy">
      <p class="hero-eyebrow">Open research community</p>
      <h1 class="hero-h1">
        Read better quant research. <span class="hero-em">Discuss the methods. Share your work.</span>
      </h1>
      <p class="hero-lead">
        Start with a curated reading list, discuss papers in our LinkedIn group, and send us a
        replication or method note when you have one.
      </p>
      <div class="hero-ctas">
        <a href={JOIN_URL} target="_blank" rel="noopener" class="btn btn-solid">Join the community</a>
        <a href="/research/" class="btn btn-outline">See the reading list</a>
      </div>
      <div class="hero-stats">
        {aboutStats.map(([n, l]) => (
          <div class="hero-stat">
            <span class="hero-stat-n">{n}</span>
            <span class="hero-stat-l">{l}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The map sits below the hero, full width, rather than beside the copy. -->
  <section class="hero-visual">
    <div class="shell">
      <KnowledgeGraph height={420} legend={false} />
      <p class="hero-visual-cap">An illustrative map of topics in the reading list and writing. Drag a node to explore.</p>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="band band-center">
    <div class="shell">
      <div class="kicker rv"><span class="kicker-n">01</span><span class="kicker-rule"></span><span>Why join</span></div>
      <h2 class="headline headline-rule rv">What you actually get.</h2>
      <div class="value-grid rv rv-stagger">
        {value.map((v) => (
          <div class="value-item">
            <div class="value-n">{v.n}</div>
            <h3 class="value-title">{v.title}</h3>
            <p class="value-body">{v.body}</p>
            <a
              href={v.href}
              class="arrow-link value-cta"
              target={v.external ? '_blank' : undefined}
              rel={v.external ? 'noopener' : undefined}
            >{v.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- READING LIST -->
  <section class="band band-center">
    <div class="shell">
      <div class="kicker rv"><span class="kicker-n">02</span><span class="kicker-rule"></span><span>Reading list</span></div>
      <h2 class="headline headline-rule rv">Start with these.</h2>
      <p class="lead rv">
        Three of the {reading.length} papers on the list. Not summaries — the reason each one is
        still worth your time.
      </p>
      <ul class="reading-list rv rv-stagger">
        {pickedReading.map((r) => (
          <li>
            <a href={r.href} target="_blank" rel="noopener" class="reading-row">
              <div class="reading-main">
                <span class="reading-title">{r.title}</span>
                <span class="reading-note">{r.note}</span>
                <span class="reading-tags">{r.tags.join(' · ')}</span>
              </div>
              <div class="reading-meta">
                <span class="reading-authors">{r.authors}</span>
                <span>{r.year}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <a href="/research/" class="arrow-link reading-all rv">All {reading.length} papers</a>
    </div>
  </section>

  <!-- WRITING -->
  <section class="band band-center">
    <div class="shell">
      <div class="kicker rv"><span class="kicker-n">03</span><span class="kicker-rule"></span><span>Writing</span></div>
      <h2 class="headline headline-rule rv">Shorter notes from the work.</h2>
      <ul class="writing-list rv rv-stagger">
        {latestPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="writing-row">
              <div class="writing-row-main">
                <span class="writing-row-title">{post.data.title}</span>
                <span class="writing-row-desc">{post.data.description}</span>
              </div>
              <div class="writing-row-meta">
                <span>{post.data.category}</span>
                <span>{monthYear(post.data.date)}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <a href="/blog/" class="arrow-link writing-all rv">All {allPosts.length} articles</a>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="band band-center">
    <div class="shell">
      <div class="kicker rv"><span class="kicker-n">04</span><span class="kicker-rule"></span><span>Who it's for</span></div>
      <h2 class="headline headline-rule rv">You'll probably fit if…</h2>
      <ul class="fit-list rv rv-stagger">
        <li class="fit-row">
          <span class="fit-who">You're starting out</span>
          <span class="fit-why">A student or career-switcher trying to get into quant, tired of being sold a course. Read what the field actually reads.</span>
        </li>
        <li class="fit-row">
          <span class="fit-who">You can already build</span>
          <span class="fit-why">An engineer or data scientist who can ship a model but wants to know which published results survive contact with real data.</span>
        </li>
        <li class="fit-row">
          <span class="fit-who">You do this for a living</span>
          <span class="fit-why">A working quant who wants to argue about method with people outside your own desk.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ABOUT — the old /about/ page, folded in. /about/ redirects to this anchor. -->
  <section class="band band-center" id="about">
    <div class="shell">
      <div class="kicker rv"><span class="kicker-n">05</span><span class="kicker-rule"></span><span>About</span></div>
      <h2 class="headline headline-rule rv">Read closely. Show your work.</h2>
      <p class="lead rv">
        QuantHQ curates papers worth reading and publishes articles about quantitative finance methods.
        Each reading note explains why its paper is on the list. Our aim is to make assumptions,
        limitations, and sources easy to inspect.
      </p>
      <p class="lead rv">
        The reading list and articles are open to everyone. Discussion happens in the LinkedIn group.
      </p>
    </div>
  </section>

  <!-- JOIN -->
  <section class="band band-center join-band">
    <div class="shell">
      <div class="kicker rv"><span class="kicker-n">06</span><span class="kicker-rule"></span><span>Join</span></div>
      <h2 class="headline join-headline headline-rule rv">Come argue about method with us.</h2>
      <p class="lead rv">
        The community runs on LinkedIn. It is free, it is public, and nobody is selling you a course.
      </p>
      <div class="hero-ctas rv">
        <a href={JOIN_URL} target="_blank" rel="noopener" class="btn btn-solid">Join the community</a>
        <a href={links.github} target="_blank" rel="noopener" class="btn btn-outline">Code on GitHub</a>
      </div>
      <p class="join-note rv">
        Curious what the research tooling looks like? The <a href="/lab/">lab</a> has interactive demos —
        everything there runs on simulated sample data.
      </p>
    </div>
  </section>
</Base>

<style>
  /* ── opening curtain ──
     Only html.intro-play shows it, so no-JS, reduced-motion, print, and every
     visit after the first render the page with no overlay at all. */
  .intro { display: none; }
  :global(html.intro-play) .intro {
    display: grid; place-items: center;
    position: fixed; inset: 0; z-index: 300;
    background: var(--bg);
    animation: introLift 1.5s cubic-bezier(.76,0,.24,1) forwards;
  }
  .intro-inner { display: grid; justify-items: center; gap: 16px; }
  .intro-mark {
    font-family: var(--font-display); font-size: clamp(34px, 6vw, 62px);
    letter-spacing: -0.03em; color: var(--text);
    animation: introMark .9s cubic-bezier(.22,1,.36,1) backwards;
  }
  .intro-rule {
    width: min(280px, 46vw); height: 1px; background: var(--border-hover);
    transform-origin: center; animation: introRule .8s cubic-bezier(.22,1,.36,1) .18s backwards;
  }
  .intro-sub {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.3em; text-transform: uppercase; color: var(--text-3);
    animation: introMark .8s cubic-bezier(.22,1,.36,1) .3s backwards;
  }
  /* the overlay ends fully transparent AND click-through — if this keyframe ever
     stops running the page must still be usable, hence pointer-events here. */
  @keyframes introLift {
    0%, 62% { opacity: 1; clip-path: inset(0 0 0 0); pointer-events: auto; }
    100% { opacity: 0; clip-path: inset(0 0 100% 0); pointer-events: none; }
  }
  @keyframes introMark { from { opacity: 0; transform: translateY(14px); } }
  @keyframes introRule { from { transform: scaleX(0); } }
  /* MUST NOT be dropped: global.css disables all animation under reduced motion,
     which would strand the curtain opaque and make the page unreachable. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.intro-play) .intro { display: none; }
    :global(html.intro-play) { --intro-lead: 0s; }
  }

  /* ── hero ──
     Single centred column: eyebrow, headline, lead, CTAs, stats. The map is its
     own full-width section below rather than a second grid column. */
  .hero { padding: clamp(56px, 9vh, 104px) 0 clamp(40px, 6vh, 64px); }
  .hero-copy { text-align: center; }
  .hero-visual { min-width: 0; padding-bottom: clamp(40px, 7vh, 76px); }
  .hero-visual-cap {
    margin-top: 14px; text-align: center; font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.06em; color: var(--text-3);
  }

  /* stats sit under the CTAs, mirroring the reference's centred metric row */
  .hero-stats {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: clamp(28px, 6vw, 72px); margin-top: 52px;
    padding-top: 40px; border-top: 1px solid var(--border);
  }
  .hero-stat { display: flex; flex-direction: column; gap: 10px; }
  .hero-stat-n {
    font-family: var(--font-mono); font-variant-numeric: tabular-nums;
    font-size: clamp(28px, 3.6vw, 42px); font-weight: 700;
    letter-spacing: -0.02em; color: var(--text); line-height: 1;
  }
  .hero-stat-l {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3);
  }

  /* ── centred bands ──
     Heading block centres; the data rows below (reading, writing, fit) stay
     left-aligned so long lines remain readable. */
  .band-center .kicker { justify-content: center; }
  .band-center .headline,
  .band-center .lead { margin-left: auto; margin-right: auto; text-align: center; }
  .band-center .headline { max-width: 24ch; }
  /* the self-drawing hairline must open from the middle under a centred headline */
  .band-center .headline-rule::after { transform-origin: center; }
  /* .arrow-link is inline-flex, so auto margins can't centre it — go to flex */
  .band-center .arrow-link { display: flex; justify-content: center; }
  .hero-eyebrow {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.24em; text-transform: uppercase; color: var(--text-3);
  }
  .hero-h1 {
    margin: 26px auto 0; max-width: 22ch;
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(40px, 5.4vw, 78px); line-height: 1.0;
    letter-spacing: -0.03em; color: var(--text);
  }
  .hero-em { color: var(--text-3); }
  .hero-lead {
    margin: 30px auto 0; max-width: 58ch;
    font-size: clamp(17px, 2vw, 21px); line-height: 1.6; color: var(--text-2);
  }
  .hero-ctas {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 12px; margin-top: 38px;
  }

  /* hero entrance — above the fold, so it runs on load rather than on scroll.
     Same `rise` keyframe as the .rv-stagger cascade.
     --intro-lead holds the hero back until the curtain is on its way up, so the
     two read as one continuous opening rather than two animations. */
  :global(html.intro-play) { --intro-lead: 0.95s; }
  :global(html.js) .hero-copy > *,
  :global(html.js) .hero-visual {
    animation: rise .8s cubic-bezier(.22,1,.36,1) backwards;
    animation-delay: var(--intro-lead, 0s);
  }
  :global(html.js) .hero-copy > :nth-child(2) { animation-delay: calc(var(--intro-lead, 0s) + .08s); }
  :global(html.js) .hero-copy > :nth-child(3) { animation-delay: calc(var(--intro-lead, 0s) + .16s); }
  :global(html.js) .hero-copy > :nth-child(4) { animation-delay: calc(var(--intro-lead, 0s) + .24s); }
  :global(html.js) .hero-copy > :nth-child(5) { animation-delay: calc(var(--intro-lead, 0s) + .32s); }
  :global(html.js) .hero-visual {
    animation-delay: calc(var(--intro-lead, 0s) + .2s); animation-duration: 1s;
  }

  /* ── value ── */
  .value-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    margin-top: 56px; background: var(--border);
    border: 1px solid var(--border); border-radius: 14px; overflow: hidden;
  }
  .value-item {
    background: var(--card-bg); padding: 34px 30px 30px;
    display: flex; flex-direction: column;
    transition: background 0.25s;
  }
  .value-item:hover { background: color-mix(in srgb, var(--text) 3%, var(--card-bg)); }
  .value-n {
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.15em; color: var(--gold); margin-bottom: 20px;
  }
  .value-title { font-size: 19px; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
  .value-body { margin-top: 12px; font-size: 15px; line-height: 1.65; color: var(--text-2); }
  .value-cta { margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--border); }

  /* ── reading list ── */
  .reading-list, .writing-list, .fit-list { margin-top: 40px; border-top: 1px solid var(--border); }
  .reading-list li, .writing-list li, .fit-list li { border-bottom: 1px solid var(--border); }

  .reading-row {
    display: grid; grid-template-columns: 1fr 210px;
    gap: 10px 32px; align-items: start; padding: 26px 4px;
    transition: padding-left 0.22s;
  }
  .reading-row:hover { padding-left: 12px; }

  /* the row reads as a control, not just shifting text: an accent bar wipes in
     from the left edge on hover. Shared by both row types. */
  .reading-row, .writing-row { position: relative; }
  .reading-row::before, .writing-row::before {
    content: ''; position: absolute; left: -4px; top: 0; bottom: 0; width: 2px;
    background: var(--accent); transform: scaleY(0); transform-origin: top;
    transition: transform 0.28s cubic-bezier(.22,1,.36,1);
  }
  .reading-row:hover::before, .writing-row:hover::before { transform: none; }
  .reading-row:focus-visible::before, .writing-row:focus-visible::before { transform: none; }

  /* the meta column nudges with the row so the whole thing moves as one piece */
  .reading-meta, .writing-row-meta { transition: transform 0.22s, color 0.22s; }
  .reading-row:hover .reading-meta,
  .writing-row:hover .writing-row-meta { transform: translateX(4px); color: var(--text-2); }
  .reading-main { display: flex; flex-direction: column; gap: 9px; min-width: 0; }
  .reading-title { font-size: 17.5px; font-weight: 500; color: var(--text-1); line-height: 1.35; }
  .reading-row:hover .reading-title { color: var(--text); }
  .reading-note { font-size: 14.5px; line-height: 1.65; color: var(--text-3); max-width: 72ch; }
  .reading-tags {
    font-family: var(--font-mono); font-size: 10.5px;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3);
  }
  .reading-meta {
    display: flex; flex-direction: column; gap: 5px; text-align: right;
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.06em; color: var(--text-3);
  }
  .reading-authors { line-height: 1.5; }
  .reading-all { margin-top: 30px; }

  /* ── who it's for ── */
  .fit-row {
    display: grid; grid-template-columns: 260px 1fr;
    gap: 10px 32px; align-items: baseline; padding: 24px 4px;
  }
  .fit-who { font-size: 17px; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
  .fit-why { font-size: 15.5px; line-height: 1.65; color: var(--text-2); max-width: 68ch; }

  .writing-row {
    display: grid; grid-template-columns: 1fr auto;
    gap: 8px 28px; align-items: baseline; padding: 24px 4px;
    transition: padding-left 0.22s;
  }
  .writing-row:hover { padding-left: 12px; }
  .writing-row-main { display: flex; flex-direction: column; gap: 7px; }
  .writing-row-title { font-size: 18px; font-weight: 500; color: var(--text-1); letter-spacing: -0.01em; }
  .writing-row:hover .writing-row-title { color: var(--text); }
  .writing-row-desc { font-size: 14.5px; line-height: 1.6; color: var(--text-3); max-width: 68ch; }
  .writing-row-meta {
    display: flex; gap: 14px; white-space: nowrap;
    font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3);
  }
  .writing-all { margin-top: 30px; }

  /* ── about ── */
  #about { scroll-margin-top: calc(var(--nav-h) + 40px); }
  .band .lead + .lead { margin-top: 18px; }

  /* ── join ── */
  .join-headline { max-width: 20ch; }
  .join-band .lead { margin-top: 22px; }
  .join-note { margin-top: 34px; font-size: 14px; color: var(--text-3); }
  .join-note a { color: var(--text-1); text-decoration: underline; text-underline-offset: 3px; }
  .join-note a:hover { color: var(--text); }

  @media (max-width: 900px) {
    .value-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .reading-row, .writing-row, .fit-row { grid-template-columns: 1fr; gap: 10px; }
    .reading-meta { flex-direction: row; gap: 10px; text-align: left; }
  }
</style>
