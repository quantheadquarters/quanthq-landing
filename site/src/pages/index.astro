---
import { getCollection } from 'astro:content';
import CommandPalette from '../components/CommandPalette.astro';
import HomeFooter from '../components/HomeFooter.astro';
import HomeNav from '../components/HomeNav.astro';
import JsonLd from '../components/JsonLd.astro';
import { projects, openSourceCount } from '../data/projects.ts';
import '../styles/home.css';

const allResearch = (await getCollection('research')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [leadPaper, ...restPapers] = allResearch;
const secondaryPapers = restPapers.slice(0, 2);

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPosts = allPosts.slice(0, 3);

const featuredProjects = projects.filter((p) => p.featured).slice(0, 4);

const monthYear = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://quanthq.in').href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://quanthq.in/#organization",
  "name": "QuantHQ",
  "url": "https://quanthq.in/",
  "logo": "https://quanthq.in/logo.jpeg",
  "sameAs": [
    "https://linkedin.com/company/quanthq",
    "https://github.com/quanthq",
    "https://discord.gg/quanthq"
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QuantHQ | Quantitative Finance & Financial AI Research</title>
<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<meta name="description" content="QuantHQ is an open research institution for quantitative finance and financial AI. Explore reproducible factor research, backtesting methods, and open-source tools.">
<meta property="og:title" content="QuantHQ | Quantitative Finance & Financial AI Research">
<meta property="og:description" content="QuantHQ is an open research institution for quantitative finance and financial AI. Explore reproducible factor research, backtesting methods, and open-source tools.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<meta property="og:url" content="https://quanthq.in/">
<meta property="og:image" content="https://quanthq.in/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:image" content="https://quanthq.in/og.png">
<meta name="twitter:title" content="QuantHQ | Quantitative Finance & Financial AI Research">
<meta name="twitter:description" content="QuantHQ is an open research institution for quantitative finance and financial AI. Explore reproducible factor research, backtesting methods, and open-source tools.">
<link rel="canonical" href={canonicalUrl} />
<JsonLd data={organizationSchema} />
<script is:inline>if(localStorage.theme==='light')document.documentElement.classList.add('light')</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet">
</head>
<body>

<!-- SKIP LINK -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- SCROLL PROGRESS -->
<div id="scroll-prog"></div>

<!-- BACKGROUND -->
<div class="bg-aurora"></div>
<div class="bg-grid" aria-hidden="true"></div>
<div class="nebula-blob nb1" aria-hidden="true"></div>
<div class="nebula-blob nb2" aria-hidden="true"></div>

<HomeNav />

<div class="vignette" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>

<main id="main-content">
<!-- HERO -->
<section class="hero" id="hero">
  <canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-spot" aria-hidden="true"></div>
  <div class="hero-floor" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-eyebrow">Open Research Institution</div>
    <h1 class="hero-h1" id="hero-h1">
      <span class="hl"><span class="hl-in">Quant</span></span>
      <span class="hl"><span class="hl-in muted">intelligence</span></span>
      <span class="hl"><span class="hl-in">for the</span></span>
      <span class="hl"><span class="hl-in grad-text"><em>obsessed</em></span></span>
    </h1>
    <p class="hero-description rv">QuantHQ is an open research institution for quantitative finance, financial AI, and systematic investing.</p>
    <div class="hero-ctas">
      <a href="/research/" class="btn-primary">Read the research →</a>
      <a href="#join" class="btn-ghost">Join the community</a>
    </div>
    <div class="hero-metrics">
      <div class="hero-metric">
        <div class="n" data-count={allResearch.length}>0</div>
        <div class="l">Published papers</div>
      </div>
      <div class="hero-metric">
        <div class="n" data-count={allPosts.length}>0</div>
        <div class="l">Published articles</div>
      </div>
      <div class="hero-metric">
        <div class="n" data-count={openSourceCount}>0</div>
        <div class="l">Open-source projects</div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED RESEARCH -->
<section class="research-strip" id="research">
  <div class="research-strip-inner">
    <div class="rv2 section-head">
      <div class="section-label">Featured Research</div>
      <h2 class="section-h2">Preprints and<br>technical reports.</h2>
      <div class="section-sub fade-in-up">Reproducible work on factor investing, financial AI, and macro regimes — methods and code published alongside the results.</div>
    </div>

    <a href={`/research/${leadPaper.id}/`} class="lead-paper rv2" data-d="1">
      <div class="lead-paper-body">
        <div class="rsi-status">{leadPaper.data.status.replace('-', ' ')}</div>
        <h3 class="lead-paper-title">{leadPaper.data.title}</h3>
        <p class="lead-paper-abstract">{leadPaper.data.abstract}</p>
        <div class="lead-paper-meta">
          <span>{leadPaper.data.authors.join(', ')}</span>
          <span>·</span>
          <span>{monthYear(leadPaper.data.date)}</span>
        </div>
        <div class="lead-paper-tags">
          {leadPaper.data.tags.map((t) => <span class="tag-chip">{t}</span>)}
        </div>
        <span class="lead-paper-cta">Read paper →</span>
      </div>
    </a>

    <div class="research-strip-grid rv2" data-d="2">
      {secondaryPapers.map((paper) => (
        <a href={`/research/${paper.id}/`} class="research-strip-item">
          <div class="rsi-status">{paper.data.status.replace('-', ' ')}</div>
          <div class="rsi-title">{paper.data.title}</div>
          <div class="rsi-meta">{paper.data.authors.join(', ')} · {monthYear(paper.data.date)}</div>
        </a>
      ))}
      <a href="/research/" class="research-strip-item rsi-all">
        <div class="rsi-status">Archive</div>
        <div class="rsi-title">All {allResearch.length} research papers</div>
        <div class="rsi-meta">Search and filter the full archive →</div>
      </a>
    </div>
  </div>
</section>

<!-- WHAT WE BUILD -->
<section class="bento-section" id="build">
  <div class="bento-inner">
    <div class="rv2 section-head">
      <div class="section-label">What we do</div>
      <h2 class="section-h2">Research, tools,<br>and a community.</h2>
    </div>
    <div class="build-grid">
      <a href="/research/" class="bento-card build-card rv2">
        <div class="bc-label">Research</div>
        <div class="bc-title">Reproducible<br>quant research</div>
        <div class="bc-sub">Preprints and technical reports on factor decay, LLM-extracted signals, and regime classification — published with data sources and methodology.</div>
        <span class="build-link">Read the archive →</span>
      </a>
      <a href="https://github.com/quanthq" target="_blank" rel="noopener" class="bento-card build-card rv2" data-d="1">
        <div class="bc-label">Open source</div>
        <div class="bc-title">Tools you<br>can run</div>
        <div class="bc-sub">Factor pipelines, a walk-forward backtest engine with realistic costs, and a cross-sectional signal scanner. Released rather than shelved.</div>
        <span class="build-link">Browse on GitHub →</span>
      </a>
      <a href="/community/" class="bento-card build-card rv2" data-d="2">
        <div class="bc-label">Community</div>
        <div class="bc-title">Researchers<br>working in the open</div>
        <div class="bc-sub">Weekly paper discussions, open-source contribution, and collaboration across quants, engineers, and students.</div>
        <span class="build-link">Meet the community →</span>
      </a>
    </div>
  </div>
</section>

<!-- ACTIVE PROJECTS -->
<section class="projects-section" id="projects">
  <div class="projects-inner">
    <div class="rv2 section-head">
      <div class="section-label">Active Projects</div>
      <h2 class="section-h2">What we're<br>building.</h2>
      <div class="section-sub fade-in-up">{projects.length} tracked projects — open-source tools, research code, and infrastructure.</div>
    </div>
    <div class="projects-grid rv2" data-d="1">
      {featuredProjects.map((p) => (
        <a
          href={p.href}
          class="project-card"
          target={p.href.startsWith('http') ? '_blank' : undefined}
          rel={p.href.startsWith('http') ? 'noopener' : undefined}
        >
          <div class="pc-head">
            <span class={`pc-status pc-${p.status.toLowerCase().replace(' ', '-')}`}>{p.status}</span>
            <span class="pc-arrow">↗</span>
          </div>
          <div class="pc-title">{p.name}</div>
          <div class="pc-desc">{p.blurb}</div>
          <div class="pc-foot">Updated {monthYear(new Date(p.updated))}</div>
        </a>
      ))}
    </div>
    <div class="lab-strip rv2" data-d="2">
      <p>The interactive dashboard, network globe, knowledge graph, and pipeline terminal live in the lab. All figures there use sample data.</p>
      <a href="/lab/" class="lab-link">Explore the lab →</a>
    </div>
  </div>
</section>

<!-- LATEST WRITING -->
<section class="writing-section" id="writing">
  <div class="writing-inner">
    <div class="rv2 section-head">
      <div class="section-label">Latest Writing</div>
      <h2 class="section-h2">Notes from<br>the work.</h2>
    </div>
    <div class="writing-list rv2" data-d="1">
      {latestPosts.map((post) => (
        <a href={`/blog/${post.id}/`} class="writing-item">
          <div class="wi-meta">
            <span class="wi-cat">{post.data.category}</span>
            <span>{monthYear(post.data.date)}</span>
            {post.data.readingTime && <span>{post.data.readingTime}</span>}
          </div>
          <div class="wi-title">{post.data.title}</div>
          <div class="wi-desc">{post.data.description}</div>
        </a>
      ))}
    </div>
    <a href="/blog/" class="writing-all">All {allPosts.length} articles →</a>
  </div>
</section>

<!-- COMMUNITY -->
<section class="community-section" id="community">
  <div class="community-inner rv2 section-head center">
    <div class="section-label">Community</div>
    <h2 class="section-h2">Join researchers and<br>engineers working in the open.</h2>
    <div class="section-sub fade-in-up">Weekly paper discussions, open-source projects, and practical quantitative finance research.</div>
    <div class="community-ctas">
      <a href="https://discord.gg/quanthq" target="_blank" rel="noopener" class="btn-primary">Join Discord</a>
      <a href="https://github.com/quanthq" target="_blank" rel="noopener" class="btn-ghost">Follow on GitHub</a>
    </div>
  </div>
</section>

<!-- EMAIL SIGNUP -->
<section class="fcta-section" id="join">
  <div class="fcta-bg-glow"></div>
  <div class="fcta-inner rv2 section-head center">
    <div class="section-label">Mailing list</div>
    <h2 class="fcta-h2">Get QuantHQ<br><span class="grad-text">research updates.</span></h2>
    <div class="fcta-sub fade-in-up">New papers, tool releases, and community events. Occasional updates — no spam, unsubscribe anytime.</div>
    <form class="signup-form" id="signup-form" onsubmit="return false">
      <input type="email" class="signup-input" placeholder="you@example.com" required aria-label="Email address">
      <button type="submit" class="signup-btn">Subscribe</button>
    </form>
    <div class="signup-note">Roughly one email a month. · <a href="https://linkedin.com/company/quanthq" target="_blank" rel="noopener" style="color:var(--text-2)">Follow on LinkedIn →</a></div>
  </div>
</section>
</main>

<HomeFooter />

<CommandPalette />

<script>
const reduced = matchMedia('(prefers-reduced-motion:reduce)').matches;

/* ── SCROLL: progress bar, nav state, heading parallax ── */
const sp = document.getElementById('scroll-prog');
const navEl = document.getElementById('nav');
const parallaxH2 = [...document.querySelectorAll('.section-h2')];
let ticking = false;
function onScroll() {
  const h = document.documentElement;
  sp.style.width = (scrollY / (h.scrollHeight - h.clientHeight) * 100) + '%';
  navEl.classList.toggle('scrolled', scrollY > 40);
  // heading parallax — measure the untransformed parent so it doesn't feed back
  for (const el of parallaxH2) {
    const r = el.parentElement.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) continue;
    el.style.transform = `translateY(${(r.top + r.height/2 - innerHeight/2) * 0.035}px)`;
  }
  ticking = false;
}
addEventListener('scroll', () => {
  if (!ticking) { requestAnimationFrame(onScroll); ticking = true; }
}, {passive:true});

/* ── REVEAL ── */
/* terminal-style decode effect for labels */
function scrambleIn(el) {
  const orig = el.textContent;
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789$#%/';
  let f = 0;
  const iv = setInterval(() => {
    f++;
    el.textContent = orig.split('').map((c, i) =>
      i < f ? c : (c === ' ' ? ' ' : chars[Math.random()*chars.length|0])
    ).join('');
    if (f >= orig.length) clearInterval(iv);
  }, 26);
}
const rio = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) {
    e.target.classList.add('in');
    if (!reduced) e.target.querySelectorAll('.section-label').forEach(scrambleIn);
    rio.unobserve(e.target);
  }
}), {threshold:0, rootMargin:'0px 0px -60px 0px'});
document.querySelectorAll('.rv2').forEach(el => rio.observe(el));
if (!reduced) setTimeout(() => scrambleIn(document.querySelector('.hero-eyebrow')), 500);

/* ── FADE-IN-UP ── */
const fadeObserver = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) { e.target.classList.add('in'); fadeObserver.unobserve(e.target); }
}), {threshold:0, rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.fade-in-up,.fade-in,.rv').forEach(el => fadeObserver.observe(el));

/* ── STAT COUNTERS — odometer roll from 0 to target when scrolled into view ── */
const fmtN = n => Math.round(n).toLocaleString('en-US');
document.querySelectorAll('[data-count]').forEach(el => { el.textContent = fmtN(+el.dataset.count); });
const cio = new IntersectionObserver(es => es.forEach(e => {
  if (!e.isIntersecting) return;
  const el = e.target;
  cio.unobserve(el);
  if (reduced) return;
  const target = +el.dataset.count, t0 = performance.now(), dur = 1100;
  (function tick(now){
    const p = Math.min(1, (now - t0) / dur);
    el.textContent = fmtN(target * (1 - Math.pow(1 - p, 3))); // easeOutCubic
    if (p < 1) requestAnimationFrame(tick);
    else { el.textContent = fmtN(target); el.style.animation = 'statGlow 0.6s ease-out'; }
  })(t0);
}), {threshold:0.5});
document.querySelectorAll('[data-count]').forEach(el => cio.observe(el));

/* ── WORD-BY-WORD HEADING REVEAL ── */
document.querySelectorAll('.section-h2').forEach(h => {
  let idx = 0;
  const wrap = node => {
    [...node.childNodes].forEach(ch => {
      if (ch.nodeType === 3) {
        const frag = document.createDocumentFragment();
        ch.textContent.split(/(\s+)/).forEach(tok => {
          if (!tok) return;
          if (/^\s+$/.test(tok)) { frag.appendChild(document.createTextNode(tok)); return; }
          const s = document.createElement('span');
          s.className = 'wrd';
          s.style.transitionDelay = (idx++ * 70)+'ms';
          s.textContent = tok;
          frag.appendChild(s);
        });
        node.replaceChild(frag, ch);
      } else if (ch.nodeType === 1 && ch.tagName !== 'BR') wrap(ch);
    });
  };
  wrap(h);
});

/* ── MAGNETIC CTA ── */
const magBtn = document.querySelector('.hero-ctas .btn-primary');
if (magBtn && !reduced) {
  addEventListener('mousemove', e => {
    const r = magBtn.getBoundingClientRect();
    const dx = e.clientX - (r.left + r.width/2), dy = e.clientY - (r.top + r.height/2);
    const d = Math.hypot(dx, dy);
    magBtn.style.transform = d < 180 ? `translate(${dx*(1-d/180)*0.35}px,${dy*(1-d/180)*0.35}px)` : '';
  }, {passive:true});
}

/* ── CARD POINTER GLOW ── */
if (!reduced) {
  document.querySelectorAll('.bento-card,.project-card').forEach(card => {
    card.addEventListener('mousemove', e => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', e.clientX - r.left + 'px');
      card.style.setProperty('--my', e.clientY - r.top + 'px');
    }, {passive:true});
  });
}

/* ── EMAIL FORM ── */
const signupForm = document.getElementById('signup-form');
if (signupForm) {
  signupForm.addEventListener('submit', e => {
    e.preventDefault();
    const input = signupForm.querySelector('.signup-input');
    const btn = signupForm.querySelector('.signup-btn');
    const email = input.value.trim();
    if (!email) return;
    btn.textContent = '✓ Subscribed';
    btn.style.background = 'var(--green)';
    btn.style.color = '#04060B';
    input.disabled = true;
    btn.disabled = true;
    const note = document.querySelector('.signup-note');
    if (note) note.textContent = `We'll send updates to ${email}.`;
  });
}

/* ── HERO: cursor-reactive light + constellation particle field ── */
(function heroFX(){
  const hero = document.getElementById('hero');
  const spot = document.querySelector('.hero-spot');
  const canvas = document.getElementById('hero-canvas');
  if (!hero || !canvas) return;

  // pointer-follow light (cheap: just moves a radial-gradient origin)
  if (spot && !reduced) {
    hero.addEventListener('pointermove', e => {
      const r = hero.getBoundingClientRect();
      spot.style.setProperty('--hx', ((e.clientX - r.left) / r.width * 100) + '%');
      spot.style.setProperty('--hy', ((e.clientY - r.top) / r.height * 100) + '%');
    }, { passive: true });
  }

  const ctx = canvas.getContext('2d');
  let W, H, DPR, nodes = [], raf = null, running = false;
  const mouse = { x: -9999, y: -9999 };
  const isLight = () => document.documentElement.classList.contains('light');

  function resize() {
    const r = hero.getBoundingClientRect();
    DPR = Math.min(devicePixelRatio || 1, 2);
    W = r.width; H = r.height;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    const count = Math.min(70, Math.round(W * H / 26000));
    nodes = Array.from({ length: count }, () => ({
      x: Math.random() * W, y: Math.random() * H,
      vx: (Math.random() - 0.5) * 0.22, vy: (Math.random() - 0.5) * 0.22,
      r: 0.8 + Math.random() * 1.4,
    }));
  }
  function step() {
    ctx.clearRect(0, 0, W, H);
    const light = isLight();
    const dot = light ? '15,23,42' : '150,180,255';
    const line = light ? '37,99,235' : '90,130,255';
    for (const n of nodes) {
      // gentle drift + soft cursor repulsion
      const dx = n.x - mouse.x, dy = n.y - mouse.y, d2 = dx*dx + dy*dy;
      if (d2 < 14000) { const f = (14000 - d2) / 14000 * 0.6; n.vx += dx / Math.sqrt(d2 || 1) * f; n.vy += dy / Math.sqrt(d2 || 1) * f; }
      n.x += n.vx; n.y += n.vy; n.vx *= 0.96; n.vy *= 0.96;
      if (n.x < 0 || n.x > W) n.vx *= -1;
      if (n.y < 0 || n.y > H) n.vy *= -1;
      n.x = Math.max(0, Math.min(W, n.x)); n.y = Math.max(0, Math.min(H, n.y));
    }
    // links
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i], b = nodes[j];
        const dx = a.x - b.x, dy = a.y - b.y, d = Math.hypot(dx, dy);
        if (d < 128) {
          ctx.strokeStyle = `rgba(${line},${(1 - d / 128) * 0.16})`;
          ctx.lineWidth = 0.6;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
        }
      }
    }
    // nodes
    for (const n of nodes) {
      ctx.fillStyle = `rgba(${dot},0.5)`;
      ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2); ctx.fill();
    }
    raf = requestAnimationFrame(step);
  }
  function start(){ if (!running && !reduced) { running = true; step(); } }
  function stop(){ running = false; if (raf) cancelAnimationFrame(raf); }

  resize();
  addEventListener('resize', resize, { passive: true });
  hero.addEventListener('pointermove', e => { const r = hero.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; }, { passive: true });
  hero.addEventListener('pointerleave', () => { mouse.x = mouse.y = -9999; });

  if (reduced) { // one static frame, no animation loop
    const dot = isLight() ? '15,23,42' : '150,180,255';
    for (const n of nodes) { ctx.fillStyle = `rgba(${dot},0.4)`; ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, Math.PI*2); ctx.fill(); }
  } else {
    // pause when hero scrolls out of view
    const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting ? start() : stop()), { threshold: 0.02 });
    io.observe(hero);
  }
})();

/* ── HERO: clip-reveal is CSS-driven; disable it under reduced-motion ── */
if (reduced) {
  document.querySelectorAll('.hero-h1 .hl-in').forEach(el => { el.style.animation = 'none'; el.style.transform = 'none'; });
}
</script>
</body>
</html>
