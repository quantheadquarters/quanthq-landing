---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import JsonLd from '../../components/JsonLd.astro';
import { JOIN_URL } from '../../data/links.ts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth <= 3);
const canonicalUrl = new URL(`/blog/${post.id}/`, Astro.site ?? 'https://quanthq.in').href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": canonicalUrl,
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.date.toISOString(),
  "dateModified": post.data.date.toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "QuantHQ",
    "url": "https://quanthq.in/"
  },
  "url": canonicalUrl,
  "mainEntityOfPage": canonicalUrl
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://quanthq.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://quanthq.in/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.title,
      "item": canonicalUrl
    }
  ]
};
---
<Base title={`${post.data.title} — QuantHQ Blog`} description={post.data.description}>
  <JsonLd data={articleSchema} />
  <JsonLd data={breadcrumbSchema} />
  <div id="read-prog" class="fixed left-0 h-px w-0 bg-gradient-to-r from-[var(--accent)] to-[var(--accent2)] z-40" style="top: var(--nav-h)"></div>

  <article class="px-8 pt-20 pb-10">
    <div class="max-w-[var(--shell)] mx-auto lg:grid lg:grid-cols-[1fr_240px] lg:gap-16">
      <div class="max-w-3xl">
        <nav class="flex items-center gap-2 text-[12px] text-[var(--text-3)] mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[var(--text-1)] transition-colors">Home</a>
          <span class="text-[var(--border)]">/</span>
          <a href="/blog/" class="hover:text-[var(--text-1)] transition-colors">Blog</a>
          <span class="text-[var(--border)]">/</span>
          <span class="text-[var(--text-2)] truncate max-w-[200px]">{post.data.title}</span>
        </nav>
        <div class="text-[10px] uppercase tracking-[0.15em] text-[var(--accent2)] font-semibold">{post.data.category}</div>
        <h1 class="mt-4 text-[clamp(32px,4.8vw,60px)] display-title leading-[1.02]">{post.data.title}</h1>
        <div class="mt-5 flex items-center gap-3 text-[13px] text-[var(--text-2)]">
          <span class="text-[var(--text-1)] font-medium">{post.data.author}</span>
          <span>{post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          {post.data.readingTime && <span>· {post.data.readingTime}</span>}
        </div>
        <div class="mt-10 prose-dark text-[15.5px]">
          <Content />
        </div>

        <!-- No reaction buttons here. They were localStorage-backed, so every
             reader saw their own clicks echoed back as if they were a tally.
             Discussion happens in the group, where it is real. -->
        <div class="mt-16 border-t border-[var(--border)] pt-8">
          <div class="text-[10px] uppercase tracking-[0.2em] text-[var(--text-3)] font-semibold mb-3">Disagree with this?</div>
          <p class="text-[var(--text-2)] text-[15px] leading-relaxed max-w-lg">
            Take it up in the group — that is what it is for.
          </p>
          <a href={JOIN_URL} target="_blank" rel="noopener" class="arrow-link mt-5">Join the community</a>
        </div>
      </div>

      {toc.length > 0 && (
        <aside class="hidden lg:block">
          <div class="sticky top-28">
            <div class="text-[10px] uppercase tracking-[0.2em] text-[var(--text-3)] font-semibold mb-4">Contents</div>
            <nav class="flex flex-col gap-2.5 text-[13px] border-l border-[var(--border)]">
              {toc.map((h) => (
                <a href={`#${h.slug}`} class={`text-[var(--text-2)] hover:text-[var(--text-1)] pl-4 transition-colors ${h.depth === 3 ? 'pl-8' : ''}`}>{h.text}</a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </article>

  <script>
    // ClientRouter re-runs page scripts on every navigation, so a bare
    // addEventListener('scroll') here stacked up a new listener per visit, each
    // still pointing at the previous page's (now detached) progress bar.
    // AbortController tears the old one down on the way out.
    document.addEventListener('astro:page-load', () => {
      const prog = document.getElementById('read-prog');
      if (!prog) return;
      const ac = new AbortController();
      addEventListener('scroll', () => {
        const h = document.documentElement;
        const scrollable = h.scrollHeight - h.clientHeight;
        prog.style.width = (scrollable > 0 ? (h.scrollTop / scrollable) * 100 : 0) + '%';
      }, { passive: true, signal: ac.signal });
      document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    });
  </script>
</Base>
