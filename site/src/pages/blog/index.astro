---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import JsonLd from '../../components/JsonLd.astro';
const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": posts.map((post, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": post.data.title,
    "url": `https://quanthq.in/blog/${post.id}/`
  }))
};
---
<Base title="Quant Finance & Financial AI Blog | QuantHQ" description="Practical guides and essays on quantitative research, backtesting, financial AI, factor investing, and systematic trading.">
  <JsonLd data={itemListSchema} />
  <section class="px-8 pt-12 pb-8">
    <div class="max-w-[var(--shell)] mx-auto page-head">
      <div class="section-label mb-6">Writing</div>
      <h1 class="text-[clamp(44px,7vw,92px)] display-title leading-none">Writing</h1>
      <p class="mt-5 text-[var(--text-2)] max-w-md mx-auto">Notes on quantitative finance, methods, engineering, and AI.</p>
    </div>
  </section>

  <section class="px-8">
    <div class="max-w-[var(--shell)] mx-auto index-list">
      {posts.map((p) => (
        <a href={`/blog/${p.id}/`} class="index-row">
          <div>
            <div class="index-eyebrow">{p.data.category}</div>
            <h2>{p.data.title}</h2>
            <p class="mt-3 text-[15px]">{p.data.description}</p>
          </div>
          <div class="index-meta">
            <span>{p.data.author}</span>
            <span>{p.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            <span>Read article →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

</Base>
