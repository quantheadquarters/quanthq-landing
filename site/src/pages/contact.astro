---
import Base from '../layouts/Base.astro';
import { links, JOIN_URL } from '../data/links.ts';
---
<Base title="Contact QuantHQ | Research Collaboration" description="Contact QuantHQ about research collaboration, speaking, partnerships, open-source work, or joining the quantitative finance community.">
  <section class="px-8 pt-12 pb-8">
    <div class="max-w-3xl mx-auto page-head">
      <div class="section-label mb-6">Contact</div>
      <h1 class="text-[clamp(44px,7vw,92px)] display-title leading-none">Get in touch.</h1>
      <p class="mt-5 text-[var(--text-2)] text-[17px] max-w-lg mx-auto">For a research note, send a short summary, a link to the work, and what feedback you want. You can also write about collaborations or speaking.</p>
    </div>
  </section>

  <section class="px-8">
    <div class="max-w-3xl mx-auto index-list">
      <a href={`mailto:${links.email}`} class="index-row">
        <div>
          <div class="index-eyebrow">01 / Email</div>
          <h2>{links.email}</h2>
          <p class="mt-3">Research notes · collaborations · speaking</p>
        </div>
        <div class="index-meta">Write to us →</div>
      </a>
      <a href={JOIN_URL} target="_blank" rel="noopener" class="index-row">
        <div>
          <div class="index-eyebrow">02 / Community</div>
          <h2>LinkedIn group</h2>
          <p class="mt-3">Share a paper or ask about its method.</p>
        </div>
        <div class="index-meta">Join the discussion ↗</div>
      </a>
      <a href={links.github} target="_blank" rel="noopener" class="index-row">
        <div>
          <div class="index-eyebrow">03 / Code</div>
          <h2>GitHub</h2>
          <p class="mt-3">Browse the open source projects.</p>
        </div>
        <div class="index-meta">Explore projects ↗</div>
      </a>
    </div>
  </section>
</Base>
