---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects.ts';
import { links, JOIN_URL } from '../data/links.ts';
const channels = [
  {
    title: 'LinkedIn Group',
    desc: 'Where papers get posted and picked apart. Free and public.',
    meta: 'Join the community',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
    color: 'var(--accent)',
    href: JOIN_URL,
  },
  {
    title: 'Hackathons',
    desc: 'Quarterly quant hackathons with real datasets and prizes.',
    meta: 'Coming soon',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
    color: 'var(--gold)',
    href: JOIN_URL,
  },
  {
    title: 'Reading Groups',
    desc: 'Weekly paper walkthroughs across factors, ML, and macro.',
    meta: 'Every Tuesday',
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
    color: 'var(--green)',
    href: JOIN_URL,
  },
  {
    title: 'Open Source',
    desc: 'Contribute to the agent framework and research tooling.',
    meta: `${projects.length} tracked projects`,
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>',
    color: 'var(--text-2)',
    href: links.github,
  },
];
---
<Base title="Quantitative Finance Community | QuantHQ" description="Join a global community of quants, engineers, and students for research discussions, hackathons, open-source projects, and collaboration.">
  <section class="px-8 pt-20 pb-8">
    <div class="max-w-[var(--shell)] mx-auto">
      <div class="section-label mb-6">Global Network</div>
      <h1 class="text-[clamp(52px,8vw,112px)] display-title leading-[0.92]">Meet the QuantHQ<br />community.</h1>
      <p class="mt-5 text-[var(--text-2)] max-w-md">Where researchers, engineers, and students collaborate on the future of quantitative finance. Join us for research discussions, hackathons, open-source projects, and collaboration opportunities.</p>
    </div>
  </section>

  <section class="px-8">
    <div class="max-w-[var(--shell)] mx-auto grid md:grid-cols-2 gap-4">
      {channels.map((ch) => (
        <a href={ch.href} target={ch.href.startsWith('http') ? '_blank' : undefined} rel={ch.href.startsWith('http') ? 'noopener' : undefined} class="card p-7 flex flex-col group rv min-h-[224px]">
          <div class="w-11 h-11 rounded-xl bg-[var(--surface-2)] flex items-center justify-center mb-6" style={`color: ${ch.color}`} set:html={ch.icon} />
          <h2 class="text-xl font-semibold text-[var(--text-1)] group-hover:text-[var(--text)] transition-colors">{ch.title}</h2>
          <p class="mt-2.5 text-sm text-[var(--text-2)] leading-relaxed max-w-sm">{ch.desc}</p>
          <div class="mt-auto flex items-center justify-between pt-6 border-t border-[var(--border)]">
            <span class="font-mono text-[11px] tracking-[0.06em] text-[var(--text-3)]">{ch.meta}</span>
            <span class="text-[11px] uppercase tracking-[0.15em] font-semibold group-hover:translate-x-0.5 transition-transform" style={`color: ${ch.color}`}>Join →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="px-8 mt-6">
    <div class="max-w-[var(--shell)] mx-auto card px-8 py-14 text-center rv relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--gold)] to-transparent opacity-40"></div>
      <h2 class="text-[clamp(30px,4.4vw,52px)] display-title leading-none">Join the network</h2>
      <p class="mt-4 text-[var(--text-2)]">Join researchers, engineers, and students building in the open.</p>
      <a href={JOIN_URL} target="_blank" rel="noopener" class="btn btn-solid mt-8">Join the community</a>
    </div>
  </section>
</Base>
