---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects.ts';
import { reading } from '../data/reading.ts';
import { links, JOIN_URL } from '../data/links.ts';
const channels = [
  {
    title: 'LinkedIn Group',
    desc: 'Post a paper, ask about its method, or follow the discussion. Free and public.',
    meta: 'Join the community',
    href: JOIN_URL,
    cta: 'Join',
  },
  // No hackathons or reading groups here until they actually run on a schedule
  // somebody can show up to. Every card below is something that exists today.
  {
    title: 'Reading List',
    desc: 'The papers we keep coming back to, each with a note on why it earns the spot.',
    meta: `${reading.length} papers`,
    href: '/research/',
    cta: 'Read',
  },
  {
    title: 'Open Source',
    desc: 'Explore factor research notebooks in finance-project-quant. Issues and pull requests welcome.',
    meta: `${projects.length} tracked projects`,
    href: projects.find((project) => project.featured)?.href ?? links.github,
    cta: 'View repo',
  },
];
---
<Base title="Quantitative Finance Community | QuantHQ" description="Join a global community of quants, engineers, and students for research discussion, a curated reading list, and open-source work.">
  <section class="px-8 pt-12 pb-8">
    <div class="max-w-[var(--shell)] mx-auto page-head">
      <div class="section-label mb-6">Community</div>
      <h1 class="text-[clamp(44px,7vw,92px)] display-title leading-[0.95]">Meet the QuantHQ community.</h1>
      <p class="mt-5 text-[var(--text-2)] max-w-xl mx-auto">Where researchers, engineers, and students argue about method. The group is free and public, the reading list is open, and the code is on GitHub.</p>
    </div>
  </section>

  <section class="px-8">
    <div class="max-w-[var(--shell)] mx-auto grid md:grid-cols-2 gap-4">
      {channels.map((ch, i) => (
        <a href={ch.href} target={ch.href.startsWith('http') ? '_blank' : undefined} rel={ch.href.startsWith('http') ? 'noopener' : undefined} class:list={['card p-7 md:p-9 flex flex-col group', { 'md:col-span-2': i === 0 }]}>
          <div class="font-mono text-xs text-[var(--accent)] mb-5">0{i + 1} / {ch.meta}</div>
          <h2 class:list={['display-title text-[var(--text)] leading-none', i === 0 ? 'text-[clamp(36px,5vw,60px)]' : 'text-[34px]']}>{ch.title}</h2>
          <p class="mt-3 text-[15px] text-[var(--text-2)] leading-relaxed max-w-xl">{ch.desc}</p>
          <div class="mt-7 pt-5 border-t border-[var(--border)]">
            <span class="arrow-link">{ch.cta}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
