---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import JsonLd from '../../components/JsonLd.astro';
import { reading } from '../../data/reading';
const papers = (await getCollection('research')).sort((a, b) => +b.data.date - +a.data.date);
const featured = papers.find((p) => p.data.featured);
const rest = papers.filter((p) => p !== featured);
// Keep the pinned order consistent with the homepage's starting three.
const readingList = [...reading].sort((a, b) => Number(!!b.pinned) - Number(!!a.pinned));
const paths = [
  { title: 'Start with the foundations', note: 'How portfolios, risk, and factors became the language of the field.', titles: ['Portfolio Selection', 'Capital Asset Prices: A Theory of Market Equilibrium under Conditions of Risk', 'Common Risk Factors in the Returns on Stocks and Bonds'] },
  { title: 'Learn to test claims', note: 'What happens when costs, multiple trials, and baselines enter the picture.', titles: ['Optimal Execution of Portfolio Transactions', '… and the Cross-Section of Expected Returns', 'The Deflated Sharpe Ratio: Correcting for Selection Bias, Backtest Overfitting and Non-Normality'] },
  { title: 'Inspect modern methods', note: 'Where machine learning meets return prediction and order book data.', titles: ['Empirical Asset Pricing via Machine Learning', 'Universal Features of Price Formation in Financial Markets: Perspectives from Deep Learning', 'DeepLOB: Deep Convolutional Neural Networks for Limit Order Books'] },
];
const searchIndex = [
  ...papers.map((p) => ({
    id: p.id,
    title: p.data.title,
    abstract: p.data.abstract,
    authors: p.data.authors.join(' '),
    tags: p.data.tags,
  })),
  ...reading.map((r) => ({
    id: r.href,
    title: r.title,
    abstract: `${r.note} ${r.venue}`,
    authors: r.authors,
    tags: r.tags,
  })),
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": papers.map((paper, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": paper.data.title,
    "url": `https://quanthq.in/research/${paper.id}/`
  }))
};
---
<Base title="Quant Research Reading List | QuantHQ" description={`${reading.length} papers we recommend on asset pricing, factor investing, market microstructure, and machine learning in finance — each with a note on why it earns its place.`}>
  {papers.length > 0 && <JsonLd data={itemListSchema} />}
  <section class="px-8 pt-12 pb-8">
    <div class="max-w-[var(--shell)] mx-auto page-head">
      <div class="section-label mb-6">Reading list</div>
      <h1 class="text-[clamp(44px,7vw,92px)] display-title leading-none">A quant research reading list.</h1>
      <p class="mt-5 text-[var(--text-2)] max-w-xl">{reading.length} primary sources with short editorial notes. Follow a path below, or search the full list by author, title, or topic.</p>

      <input
        id="paper-search"
        type="search"
        placeholder="Search papers, authors, topics…"
        class="mt-9 w-full max-w-lg px-5 py-3.5 rounded-lg bg-[var(--card-bg)] border border-[var(--border)] text-sm text-[var(--text)] placeholder:text-[var(--text-3)] focus:border-accent-40 focus:outline-none"
      />
    </div>
  </section>

  <section class="px-8 pb-10">
    <div class="max-w-[var(--shell)] mx-auto grid md:grid-cols-3 gap-px border border-[var(--border)] bg-[var(--border)]">
      {paths.map((path, i) => (
        <div class="bg-[var(--card-bg)] p-6 md:p-7">
          <div class="font-mono text-xs text-[var(--accent)]">0{i + 1} / Reading path</div>
          <h2 class="display-title text-[30px] leading-tight mt-4">{path.title}</h2>
          <p class="text-[var(--text-2)] text-sm leading-relaxed mt-2">{path.note}</p>
          <ol class="mt-5 pt-4 border-t border-[var(--border)] space-y-3">
            {path.titles.map((title, index) => {
              const paper = reading.find((item) => item.title === title);
              return paper && <li class="text-[13px] leading-snug"><a class="text-[var(--text-1)] hover:text-[var(--accent)]" href={paper.href} target="_blank" rel="noopener"><span class="font-mono text-[var(--text-3)] mr-2">{index + 1}.</span>{paper.title} ↗</a></li>;
            })}
          </ol>
        </div>
      ))}
    </div>
  </section>

  {papers.length > 0 && (
    <section class="px-8 pt-4 pb-2" data-section="ours">
      <div class="max-w-[var(--shell)] mx-auto">
        <h2 class="section-label">Papers</h2>
      </div>
    </section>
  )}

  {featured && (
    <section class="px-8 pb-8" id="featured-section" data-section="ours">
      <div class="max-w-[var(--shell)] mx-auto">
        <a href={`/research/${featured.id}/`} class="card p-8 md:p-11 block paper-item group rv relative overflow-hidden" data-id={featured.id} data-tags={featured.data.tags.join(',')}>
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[var(--accent)] to-[var(--accent2)]"></div>
          <div class="flex flex-wrap items-center gap-2 mb-5">
            <span class="text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 rounded-full bg-accent-10 border border-accent-20 text-[var(--accent)] font-semibold">★ Featured</span>
            {featured.data.tags.map((t) => (
              <span class="text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 rounded-full border border-accent-20 text-[var(--accent)] font-semibold">{t}</span>
            ))}
            <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--text-3)] ml-auto">{featured.data.status}{featured.data.conference ? ` · ${featured.data.conference}` : ''}</span>
          </div>
          <h2 class="text-[clamp(26px,3.4vw,44px)] display-title leading-[1.05] text-[var(--text)] group-hover:text-[var(--accent)] transition-colors max-w-4xl">{featured.data.title}</h2>
          <p class="mt-4 text-[15px] text-[var(--text-2)] leading-relaxed max-w-3xl">{featured.data.abstract}</p>
          <div class="mt-6 flex items-center gap-4 text-[12px] text-[var(--text-3)]">
            <span class="text-[var(--text-2)] font-medium">{featured.data.authors.join(' · ')}</span>
            <span class="font-mono">{featured.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            <span class="ml-auto text-[var(--accent)] font-semibold uppercase text-[11px] tracking-wide group-hover:tracking-wider transition-all">Read paper →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="px-8">
    <div class="max-w-[var(--shell)] mx-auto">
      <p id="paper-empty" class="hidden text-[var(--text-2)] text-sm py-8">No papers match that search.</p>
    </div>
    <div class="max-w-[var(--shell)] mx-auto flex flex-col gap-4" id="paper-list" data-section="ours">
      {rest.map((p) => (
        <a href={`/research/${p.id}/`} class="card p-8 block paper-item group" data-id={p.id} data-tags={p.data.tags.join(',')}>
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {p.data.tags.map((t) => (
              <span class="text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 rounded-full border border-accent-20 text-[var(--accent)] font-semibold">{t}</span>
            ))}
            <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--text-3)] ml-auto">{p.data.status}{p.data.conference ? ` · ${p.data.conference}` : ''}</span>
          </div>
          <h2 class="text-xl font-semibold text-[var(--text-1)] leading-snug group-hover:text-[var(--text)] transition-colors">{p.data.title}</h2>
          <p class="mt-3 text-sm text-[var(--text-2)] leading-relaxed line-clamp-3 max-w-3xl">{p.data.abstract}</p>
          <div class="mt-5 flex items-center gap-4 text-[12px] text-[var(--text-3)]">
            <span class="text-[var(--text-2)] font-medium">{p.data.authors.join(' · ')}</span>
            <span class="font-mono">{p.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            <span class="ml-auto text-[var(--accent)] font-semibold uppercase text-[11px] tracking-wide group-hover:tracking-wider transition-all">Read paper →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="px-8 pt-8 pb-6" data-section="reading">
    <div class="max-w-[var(--shell)] mx-auto">
      <h2 class="section-label">Recommended reading · {reading.length} papers</h2>
      <p class="mt-4 text-[var(--text-2)] text-[15px] leading-relaxed max-w-2xl">These are selected for a useful idea, method, or limitation. A note explains our reason for including each one, not an endorsement of every conclusion. Links lead to primary sources; some may be behind a paywall.</p>
    </div>
  </section>

  <section class="px-8 pb-4" data-section="reading">
    <div class="max-w-[var(--shell)] mx-auto index-list">
      {readingList.map((r) => (
        <a href={r.href} target="_blank" rel="noopener" class="index-row paper-item" data-id={r.href}>
          <div>
            <div class="index-eyebrow">{r.pinned ? 'Core reading · ' : ''}{r.tags.join(' / ')}</div>
            <h3>{r.title}</h3>
            <p class="mt-2 text-[13px]">{r.authors}</p>
            <p class="mt-3 text-[15px]">{r.note}</p>
          </div>
          <div class="index-meta">
            <span>{r.year}</span><span>{r.venue}</span><span>Open paper ↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script define:vars={{ searchIndex }} data-astro-rerun>
    (function () {
    const items = [...document.querySelectorAll('.paper-item')];
    // Local substring search keeps the reading list usable without a dependency.
    const haystack = new Map(searchIndex.map((p) => [p.id,
      [p.title, p.abstract, p.authors, (p.tags || []).join(' ')].join(' ').toLowerCase()]));

    function apply() {
      const input = document.getElementById('paper-search');
      const q = input.value.trim().toLowerCase();
      const matched = q
        ? new Set([...haystack].filter(([, t]) => t.includes(q)).map(([id]) => id))
        : null;
      let shown = 0;
      items.forEach((el) => {
        const qOk = !matched || matched.has(el.dataset.id);
        const on = qOk;
        if (on) shown++;
        el.dataset.on = on ? '1' : '';
        // the featured card lives in its own section — hide the section so its
        // padding doesn't leave a phantom gap when it is filtered out
        (el.closest('#featured-section') || el).style.display = on ? '' : 'none';
      });
      // headings/intros belong to a group ("ours", "reading") — hide the whole
      // group when a filter empties it, so no header stands over nothing
      const live = new Set(items.filter((el) => el.dataset.on)
        .map((el) => el.closest('[data-section]')?.dataset.section));
      document.querySelectorAll('[data-section]').forEach((s) => {
        // the featured section is hidden by its own card above — don't fight it
        if (s.id === 'featured-section') return;
        s.style.display = live.has(s.dataset.section) ? '' : 'none';
      });
      document.getElementById('paper-empty').classList.toggle('hidden', shown > 0);
    }

    document.getElementById('paper-search')?.addEventListener('input', apply);
    })();
  </script>
</Base>
