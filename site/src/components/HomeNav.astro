---
// Nav for the standalone home-system pages (index.astro, lab.astro), which use
// home.css rather than Base.astro. Link set matches Base.astro's nav.
---
<nav id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <svg width="28" height="28" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0;color:var(--white)">
        <rect x="3" y="3" width="22" height="22" rx="3" stroke="currentColor" stroke-width="2.2" fill="none"/>
        <text x="7.5" y="19.5" font-family="Inter,system-ui,sans-serif" font-weight="800" font-size="10.5" fill="currentColor">HQ</text>
        <rect x="22" y="22" width="9" height="9" rx="2" fill="#3D7BFF"/>
      </svg>
      QuantHQ
    </a>
    <div class="nav-links" id="nav-links">
      <a href="/about/">About</a>
      <a href="/research/">Research</a>
      <a href="/blog/">Blog</a>
      <a href="/community/">Community</a>
      <a href="/contact/">Contact</a>
      <a href="https://www.linkedin.com/groups/36960154/" target="_blank" rel="noopener" class="nav-links-cta">Join the community</a>
    </div>
    <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle light mode">
      <svg class="tt-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      <svg class="tt-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <a href="https://www.linkedin.com/groups/36960154/" target="_blank" rel="noopener" class="nav-cta">Join →</a>
  </div>
</nav>

<script>
  const hamburger = document.getElementById('nav-hamburger');
  const navLinks = document.getElementById('nav-links');
  if (hamburger && navLinks) {
    hamburger.addEventListener('click', () => {
      const open = navLinks.classList.toggle('open');
      hamburger.classList.toggle('active', open);
      hamburger.setAttribute('aria-expanded', String(open));
    });
    navLinks.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        navLinks.classList.remove('open');
        hamburger.classList.remove('active');
        hamburger.setAttribute('aria-expanded', 'false');
      });
    });
  }

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const light = document.documentElement.classList.toggle('light');
    localStorage.theme = light ? 'light' : 'dark';
    document.dispatchEvent(new CustomEvent('themechange', { detail: { light } }));
  });
</script>
